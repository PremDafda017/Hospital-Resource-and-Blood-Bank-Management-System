# React App Configuration
REACT_APP_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Razorpay Payment Gateway Configuration
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
REACT_APP_RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/hospital-bloodbank-system

# Server Configuration
PORT=5000
NODE_ENV=development

# SMTP Email Delivery Configuration (e.g. Gmail SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="HemoCare Notifications" <no-reply@hemocare.org>
FRONTEND_URL=http://localhost:3000
